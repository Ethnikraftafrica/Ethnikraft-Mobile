{
  "expo": {
    "name": "Ethnikraft-Mobile",
    "slug": "Ethnikraft-Mobile",
    "scheme": "ethnikraft",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FAF6F0"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ethnikraft.mobile"
    },
    "android": {
      "package": "com.ethnikraft.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#FAF6F0",
        "foregroundImage": "./assets/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-image",
      [
        "expo-image-picker",
        {
          "photosPermission": "The app accesses your photos to let you share workshop progress images and profile photos.",
          "cameraPermission": "The app accesses your camera to let you take workshop progress photos and product images."
        }
      ]
    ]
  }
}
